<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:sharedUserId="android.uid.system"
    tools:ignore="Deprecated">

    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <application
        android:allowBackup="false"
        android:label="PenumbraHook"
        tools:replace="android:allowBackup">
        <!-- No activities, no receivers, no services of our own.
             This APK exists only to be loaded into other processes
             via sharedLibraryFiles. -->

        <!-- The MusicKit auth AAR ships an OAuth redirect Activity we don't use
             (we supply tokens directly via TokenProvider). Drop it so its missing
             android:exported doesn't fail the manifest merge. -->
        <activity
            android:name="com.apple.android.sdk.authentication.SDKUriHandlerActivity"
            tools:node="remove" />

        <!-- Authoritative list of packages the injector should target at boot.
             Comma-separated Android package names. -->
        <meta-data
            android:name="com.penumbraos.hook.TARGET_PACKAGES"
            android:value="hu.ma.ne.ironman,humane.voice.tts,humane.experience.dialer,humane.experience.messages,humane.experience.onboarding,humane.experience.photography,hu.ma.ne.krypto,humane.experience.systemnavigation,humane.experience.settings,humane.connectivity.esimlpa,humane.experience.music,com.memfault.usagereporter" />
    </application>
</manifest>
